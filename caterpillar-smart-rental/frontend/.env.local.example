# Copy to .env.local to override defaults. .env.local is gitignored.

# Default is the real backend at http://localhost:8000. Set to "mock" to
# fall back to the in-browser mock engine (frontend-only work, no backend
# running).
# VITE_API_MODE=mock

# Override the backend base URL if it's not on localhost:8000.
# VITE_API_BASE=http://localhost:8000
